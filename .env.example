# MP4 Summary Pipeline Configuration

# ── API Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# ── STT ──────────────────────────────────────────────────────────────
# "elevenlabs" (화자분리 지원) 또는 "whisper"
STT_PROVIDER=elevenlabs

# 파이프라인 내부 동시 처리 워커 (트랜스크립션 청크/교정 배치)
MAX_WORKERS=20

# ── 모델 (전부 .env 로 종속성 주입) ───────────────────────────────────
# GPT 교정 모델 (extract_and_correct.py)
CORRECTION_MODEL=gpt-5.4

# 강의 노트(요약) 생성용 Anthropic 모델 (extract_and_correct.py)
LECTURE_NOTES_MODEL=claude-opus-4-6

# 도메인 키워드 추출 모델 (domain_detector.py, scripts/bootstrap_finance_domain.py)
DOMAIN_KEYWORD_MODEL=gpt-4.1-nano

# 도메인 임베딩 모델 (domain_detector.py)
DOMAIN_EMBEDDING_MODEL=text-embedding-3-small

# bootstrap_finance_domain.py 의 prompts 초안 작성 모델
DOMAIN_DRAFT_MODEL=gpt-5.4

# 도메인 감지 정책: "auto", "generic", 또는 특정 도메인 ID
DOMAIN_DETECTION=auto
