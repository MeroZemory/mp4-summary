# ── DB / Auth ────────────────────────────────────────────
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# ── Google OAuth (선택) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lecture.example.com/api/auth/google/callback

# ── 채팅 / Q&A 백엔드 ─────────────────────────────────────
ANTHROPIC_API_KEY=

# ── 업로드 파이프라인 (extract_and_correct.py 실행용) ────
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
STT_PROVIDER=elevenlabs
DOMAIN_DETECTION=auto
# 파이프라인 내부 동시 처리 (트랜스크립션/교정)
MAX_WORKERS=20

# ── 모델 (전부 .env 가 single source of truth — 누락 시 기동 실패) ──
# 강의 기반 사용자 채팅
CHAT_MODEL=claude-sonnet-4-6
# Q&A insight 추출
INSIGHT_MODEL=claude-haiku-4-5-20251001
# ASR 한/영 mixed 코렉션
CORRECTION_MODEL=gpt-5.4-mini
# 강의 요약/정리 생성용 GPT 모델
LECTURE_GPT_MODEL=gpt-5.5
# 강의 요약/정리 생성용 Claude 모델
LECTURE_NOTES_MODEL=claude-opus-4-7
# 도메인 키워드 추출 (짧은 분류, 가벼운 모델)
DOMAIN_KEYWORD_MODEL=gpt-4.1-nano
# 도메인 임베딩
DOMAIN_EMBEDDING_MODEL=text-embedding-3-small
# bootstrap_finance_domain.py 의 prompts 초안 작성 (1회성)
DOMAIN_DRAFT_MODEL=gpt-5.4

# ── 업로드 작업 큐 워커 풀 ───────────────────────────────
# 동시에 처리할 업로드 job 수 (예: 30)
WORKER_POOL_SIZE=30
# 워커가 DB 큐를 폴링하는 주기 (초)
WORKER_POLL_INTERVAL=5
# 업로드 최대 크기 (bytes). 기본 8GB.
MAX_UPLOAD_BYTES=8589934592
